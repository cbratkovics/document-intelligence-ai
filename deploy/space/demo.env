# Runtime configuration of the public demo on Hugging Face Spaces.
# Loaded through APP_ENV_FILE by deploy/space/Dockerfile. Process environment
# variables (such as the API_KEY secret) take precedence over this file.
# tests/test_demo_safety.py asserts that this configuration can never call a
# paid provider, even when OPENAI_API_KEY is present in the environment.
APP_ENV=production
LOG_LEVEL=INFO

STORAGE_MODE=ephemeral
DATA_DIR=/home/user/data

EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_DIR=/home/user/models/fastembed
ALLOW_MODEL_DOWNLOAD=false

GENERATION_PROVIDER=none
RERANKER_MODE=heuristic

DEMO_SEED_DIR=/app/data/samples
MAX_UPLOAD_SIZE=4194304
MAX_DOCUMENTS=24

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300
CLIENT_IP_HEADER=X-Client-IP

METRICS_ENABLED=false
