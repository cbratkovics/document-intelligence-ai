# Copy to .env and adjust. Every setting is optional; the defaults give a
# persistent, lexical-only, unauthenticated local server.

# --- Access control (set this before exposing the server beyond localhost) ---
# API_KEY=change-me-to-a-long-random-string
# CORS_ORIGINS=http://localhost:3000

# --- Storage ---
STORAGE_MODE=persistent            # persistent | ephemeral
DATA_DIR=./data                    # manifest.sqlite3, index/, uploads/

# --- Providers (leave unset for the offline demo) ---
# OPENAI_API_KEY=sk-...             # enables dense retrieval and generation (paid)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=auto           # auto | none | openai | local | fastembed | hash(test only)
# GENERATION_PROVIDER=auto          # auto | none | openai
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # ONNX runtime, pip install -r requirements-demo.txt
# FASTEMBED_CACHE_DIR=./data/models/fastembed
# ALLOW_MODEL_DOWNLOAD=false        # local models must be prepared with scripts/setup/init_models.py

# --- Reranking ---
RERANKER_MODE=none                 # none | heuristic | llm | cross_encoder

# --- Public-demo controls (all off by default) ---
# DEMO_SEED_DIR=./data/samples     # ingest these files at startup; they are never evicted
# MAX_DOCUMENTS=0                  # 0 = unlimited; otherwise the oldest non-seeded document is evicted
# RATE_LIMIT_PER_MINUTE=0          # per client, sliding 60 s window; 0 = off
# RATE_LIMIT_GLOBAL_PER_MINUTE=0   # backstop across all clients; 0 = off
# CLIENT_IP_HEADER=X-Client-IP     # trusted only on requests that carry a valid API_KEY

# --- Limits and retrieval ---
MAX_UPLOAD_SIZE=10485760           # bytes
CHUNK_SIZE=1000                    # characters
CHUNK_OVERLAP=200                  # characters
SEARCH_TOP_K=5
MAX_TOP_K=50
MAX_CONTEXT_CHARS=6000
LOG_LEVEL=INFO
